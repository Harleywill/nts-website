.yarn/*
/.next/
/.pnp
/build
/coverage
/node_modules
/out/
/src/generated/prisma
next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Prisma — recursive globs so a nested prisma/prisma/dev.db (a known
# DATABASE_URL resolution quirk — see .env) is excluded too, not just
# the top-level path.
prisma/**/*.db
prisma/**/*.db.old
prisma/**/*.db-journal
prisma/**/*.sqlite
prisma/**/*.sqlite3
.worktrees/
__pycache__/
