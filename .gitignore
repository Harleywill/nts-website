# Environment Variables
# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# debug
# dependencies
# env files (can opt-in for committing if needed)
# misc
# next.js
# production
# testing
# typescript
# vercel
*.backup
*.pem
*.tsbuildinfo
.DS_Store
.env
.env*
.env.*.backup
.env.*.local
.env.backup*
.env.development.local
.env.example.backup
.env.local
.env.production.local
.env.test.local
.pnp.*
.pnpm-debug.log*
